<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG ağ güvenlik politikası (yalnızca debug build).
    Bu dosya, resource override sayesinde debug varyantında main/'deki
    production config'in YERİNE geçer; release APK'ya dahil edilmez.

    - Lokal geliştirme sunucusuna (Metro, backend) HTTP'ye izin verilir.
    - User CA'lara güvenilir → Charles/Proxyman ile trafik debug edilebilir.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Yalnızca lokal geliştirme adresleri için cleartext (HTTP) izni. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
