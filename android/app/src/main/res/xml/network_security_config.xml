<?xml version="1.0" encoding="utf-8"?>
<!--
    PRODUCTION ağ güvenlik politikası (release build).
    - Varsayılan: cleartext (HTTP) TAMAMEN YASAK. Tüm trafik HTTPS olmalı.
    - Yalnızca sistem CA'larına güvenilir (user CA'lar hariç → MITM koruması).
    - Lokal geliştirme istisnaları DEBUG build'e taşındı:
      android/app/src/debug/res/xml/network_security_config.xml
    Not: api.kampusumden.online ve S3 zaten HTTPS olduğundan cleartext
    istisnasına ihtiyaç yoktur; base-config (HTTPS + system CA) onları kapsar.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
