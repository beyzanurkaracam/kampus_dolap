{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts", 
    "**/*.tsx", 
    "./src/services/PaymentSuccess.js"
  ],
  "exclude": [
    "**/node_modules", 
    "**/Pods", 
    "**/build",
    "android",
    "ios"
  ]
}